#!/bin/sh
# sudo de mentira: roda o comando como o proprio usuario do teste.
echo "sudo $*" >> /fake/calls.log
[ ! -e /fake/knobs/sudo_denied ] || { echo "Sorry, try again." >&2; exit 1; }
while [ $# -gt 0 ]; do
  case "$1" in
    -v) exit 0 ;;
    -n) shift ;;
    *=*) export "$1"; shift ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || exit 0
FAKE_ROOT=1 exec "$@"
